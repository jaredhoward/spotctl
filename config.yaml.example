client_id: YOUR_CLIENT_ID
client_secret: YOUR_CLIENT_SECRET
refresh_token: YOUR_REFRESH_TOKEN
redirect_uri: https://your-redirect-uri

# Optional: override how often spotctl polls Spotify to confirm state changes.
# playback_poll_interval: 500ms

# Sets are named sequences of commands. Run with: spotctl run <name>
# List all configured sets with: spotctl sets
#
# Each command has:
#   action     - what to do: play, pause, next, previous, shuffle, repeat,
#                volume, transfer, sleep, run_set
#   params     - action-specific parameters (see examples below)
#   confirm    - poll Spotify state until the action is reflected before
#                moving on. Defaults to set-level confirm, then true.
#   timeout    - overall command deadline including confirmation.
#                Defaults to set-level timeout, then 15s.
#   on_error   - fail | continue | skip_remaining
#                Defaults to set-level on_error, then "fail".
#   on_timeout - same options as on_error
#
# Set-level fields:
#   device_id  - applies to all commands that don't define their own
#   confirm    - default confirm for all commands in the set
#   timeout    - default timeout for all commands in the set
#   on_error   - default error policy for all commands in the set
#   on_timeout - default timeout policy for all commands in the set
#   params     - named parameters the set accepts, each with an optional
#                default and required flag. Supply values via --<name>=<value>
#                on the CLI, or as sibling keys under run_set params.
#                A param's default can be written as a bare scalar
#                (volume: 40) instead of the full mapping form
#                (volume: { default: "40" }).
#
# To reference a param inside a command, use {{ name }} syntax:
#   uri: '{{ uri }}'
# In 'spotctl sets' output, these render as <name> (e.g. uri=<uri>).
#
# The reserved "pool" params key picks one of several candidates on each run
# (randomly, or deterministically by calendar date with method: date) and
# always resolves it to "uri". A pool entry can be a bare uri, or a mapping
# that also overrides this set's own volume/shuffle/repeat params for that
# pick only — see daily_mix below.

sets:
  # Play a playlist with shuffle and repeat on a specific device.
  random_vibes:
    device_id: YOUR_SPOTIFY_DEVICE_ID
    commands:
      - action: play
        params:
          uri: spotify:playlist:YOUR_PLAYLIST_ID
        confirm: true
        timeout: 20s
        on_timeout: fail

      - action: shuffle
        params:
          enabled: true
        confirm: true
        timeout: 5s

      - action: repeat
        params:
          state: context   # off | track | context
        confirm: true
        timeout: 5s

  # Focused listening: specific playlist, no shuffle, track repeat.
  focus_mode:
    device_id: YOUR_SPOTIFY_DEVICE_ID
    on_error: continue
    commands:
      - name: start focus playlist
        action: play
        params:
          playlist: YOUR_PLAYLIST_ID   # shorthand for spotify:playlist:ID
        confirm: true
        timeout: 15s

      - name: disable shuffle
        action: shuffle
        params:
          enabled: false
        confirm: true
        timeout: 5s

      - name: repeat off
        action: repeat
        params:
          state: off
        confirm: true
        timeout: 5s

      - name: set volume
        action: volume
        params:
          level: 40
        confirm: true
        timeout: 5s

  # Wind down: lower volume then pause. Demonstrates set composition via run_set.
  wind_down:
    device_id: YOUR_SPOTIFY_DEVICE_ID
    commands:
      - name: lower volume
        action: volume
        params:
          level: 15
        confirm: true
        timeout: 5s

      - name: pause
        action: pause
        confirm: true
        timeout: 10s

  # Full evening routine: focus music, then wind down.
  evening:
    commands:
      - action: run_set
        params:
          set: focus_mode

      - action: run_set
        params:
          set: wind_down

  # Parameterised set: play any playlist on a specific device.
  # Call with: spotctl run bedroom_play --uri spotify:playlist:YOUR_ID
  # Or compose with run_set:
  #   - action: run_set
  #     params:
  #       set: bedroom_play
  #       uri: spotify:playlist:YOUR_ID
  bedroom_play:
    device_id: YOUR_SPOTIFY_DEVICE_ID
    confirm: false
    timeout: 20s
    on_timeout: fail
    on_error: fail
    params:
      uri:
        required: true
      volume:
        default: "40"
    commands:
      - action: volume
        params:
          level: 0
      - action: pause
      - action: play
        params:
          uri: '{{ uri }}'
        confirm: true
      - action: shuffle
        params:
          enabled: true
        timeout: 5s
      - action: volume
        params:
          level: '{{ volume }}'

  # Pool of candidate playlists, picked deterministically by calendar date.
  # "Release Radar" plays quieter than the rest of the pool; every other
  # entry falls back to the set's own volume/shuffle/repeat params.
  daily_mix:
    device_id: YOUR_SPOTIFY_DEVICE_ID
    params:
      pool:
        - uri: spotify:playlist:YOUR_DAILY_MIX_1_ID
        - uri: spotify:playlist:YOUR_DAILY_MIX_2_ID
        - uri: spotify:playlist:YOUR_RELEASE_RADAR_ID
          volume: 25
      method: date
      volume: 40
      shuffle: true
      repeat: off
    commands:
      - action: play
        params:
          uri: '{{ uri }}'
        confirm: true
      - action: volume
        params:
          level: '{{ volume }}'
      - action: shuffle
        params:
          enabled: '{{ shuffle }}'
        timeout: 5s
      - action: repeat
        params:
          state: '{{ repeat }}'
        timeout: 5s
